{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Metro Quest creatures (Phase 4 Bestiario)",
 "description": "150 species exactly. Canon 29 frozen per GATE 0/Q4A: name_es, types, evolution relationships, shipped learnset rows, shipped dex_es and shipped evo levels are immutable (stages may be appended at line ends and pre-evos may point in). Stat budgets by `budget` band: s1 300–340, s2 400–440, s3 500–540, leg 570–600 (BST = sum of base). ev_yield totals 1/2/3 points for s1/s2/(s3|leg). Ability ids must exist in data/abilities/abilities.json; move ids in data/moves/moves.json. Enforced by scripts/validate_bestiario.py.",
 "type": "object",
 "required": ["schema_version", "creatures"],
 "properties": {
  "schema_version": {"const": 1},
  "notes": {"type": "string"},
  "creatures": {
   "type": "array",
   "minItems": 150,
   "maxItems": 150,
   "items": {
    "type": "object",
    "required": ["num","id","name_es","name_en","types","category","inspiration",
                 "region","habitats","budget","base","catch","exp_group","gender",
                 "abilities","ev_yield","learnset","evolves_to","dex_es","dex_en",
                 "design_brief","silhouette_progression","form","egg_group"],
    "properties": {
     "num": {"type": "integer", "minimum": 1, "maximum": 150,
             "description": "Dex number = position in array. Tren Fantasma is 150."},
     "id": {"type": "string", "pattern": "^[a-z0-9]+$"},
     "name_es": {"type": "string"},
     "name_en": {"type": "string"},
     "types": {"type": "array", "minItems": 1, "maxItems": 2,
               "items": {"enum": ["Criollo","Sabroso","Rumba","Espanto","Catatumbo","Caribe","Monte","Tepuy"]}},
     "category": {"enum": ["fauna","folklore","urban-magical"]},
     "inspiration": {"type": "string", "description": "Real-world root (animal, espanto, dish, place)."},
     "region": {"enum": ["linea1","linea2","linea3","linea4","linea5","superficie","avila",
                          "metrocable_sanagustin","metrocable_mariche","losteques"],
                "description": "Region of introduction (world bible §1–8)."},
     "habitats": {"type": "array", "items": {"enum": ["tunel","anden","matorral","parque","agua","mercado","apagon","fantasma","paramo","cable","cumbre","sendero","zoologico","boulevard"]}},
     "budget": {"enum": ["s1","s2","s3","leg"]},
     "base": {"type": "object",
              "required": ["hp","atk","def","spa","spd","spe"],
              "additionalProperties": false,
              "properties": {"hp":{"type":"integer"},"atk":{"type":"integer"},"def":{"type":"integer"},
                             "spa":{"type":"integer"},"spd":{"type":"integer"},"spe":{"type":"integer"}}},
     "catch": {"type": "integer", "minimum": 1, "maximum": 255},
     "exp_group": {"enum": ["rapido","parejo","pausado","lento"]},
     "gender": {"oneOf": [{"const": "genderless"},
                           {"type": "object", "required": ["m","f"],
                            "properties": {"m":{"type":"number"},"f":{"type":"number"}}}]},
     "abilities": {"type": "object", "required": ["primary"],
                   "properties": {"primary":{"type":"string"},
                                  "secondary":{"type":["string","null"]},
                                  "hidden":{"type":["string","null"],
                                            "description":"Rare encounters only (systems-spec §1.4)."}}},
     "ev_yield": {"type": "object", "additionalProperties": {"type":"integer","minimum":1,"maximum":3}},
     "learnset": {"type": "array", "minItems": 1,
                  "items": {"type": "array", "prefixItems": [{"type":"integer"},{"type":"string"}],
                            "minItems": 2, "maxItems": 2},
                  "description": "[level, move_id]; casete/tutor compatibility arrives with Phase 6 data."},
     "evolves_to": {"oneOf": [{"type": "null"},
                               {"type": "object", "required": ["to","method"],
                                "properties": {"to":{"type":"string"},
                                               "method":{"enum":["level","confianza"]},
                                               "level":{"type":"integer"},
                                               "confianza":{"type":"integer"}}}]},
     "dex_es": {"type": "string", "description": "Spanish is the language of record (Q12A)."},
     "dex_en": {"type": "string"},
     "design_brief": {"type": "string", "description": "Visual brief consumed by prompts/creature-concept.prompt in Phase 5."},
     "silhouette_progression": {"type": "string", "description": "Line-level shape language, same string on every stage."},
     "form": {"const": null, "description": "Reserved (systems-spec §1.4)."},
     "egg_group": {"const": null, "description": "Reserved (systems-spec §1.4)."}
    }
   }
  }
 }
}
